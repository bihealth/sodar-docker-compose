# docker-compose.override.yaml fragment for running mango from docker-compose

services:
  tika:
    image: apache/tika:3.3.1.0
    networks:
      - sodar
    restart: unless-stopped

  mango:
    image: ghcr.io/bihealth/mango-sodar:${MANGO_VERSION}
    ports:
      - 3000:3000
    restart: unless-stopped
    networks:
      - sodar
    environment:
      IRODS_HOST: "${IRODS_HOST}"
      IRODS_PORT: "${IRODS_PORT}"
      IRODS_USER: "${IRODS_USER}"
      IRODS_PASS: "${IRODS_PASS}"
      IRODS_ZONES_CONFIG: "${MANGO_IRODS_ZONES_CONFIG}"
      MANGO_GET_ZONE_OPERATOR_SESSION_FUNCTION: "${MANGO_GET_ZONE_OPERATOR_SESSION_FUNCTION}"
      MANGO_URL_PREFIX: "${MANGO_URL_PREFIX}"
      SECRET_KEY: "${MANGO_SECRET_KEY}"
      TIKA_URL: "http://tika:9998"
    depends_on:
      - irods
      - tika
    volumes:
      - type: bind  # Traefik configuration for shared certs
        source: ./config/traefik/tls/server.crt
        target: /etc/traefik/tls/server.crt
    labels:
      - "traefik.enable=true"
      - "traefik.http.middlewares.xforward.headers.customrequestheaders.X-Forwarded-Proto=https"
      - "traefik.http.routers.mango.entrypoints=websecure"
      - "traefik.http.routers.mango.middlewares=xforward"
      - "traefik.http.routers.mango.rule=HostRegexp(`.+`) && PathPrefix(`${MANGO_URL_PREFIX}`)"
      - "traefik.http.routers.mango.tls=true"
      - "traefik.http.routers.mango.priority=100"
      - "traefik.http.services.mango.loadbalancer.server.port=3000"
